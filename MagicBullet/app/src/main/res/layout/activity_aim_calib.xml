<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <com.magicbullet.capture.widget.CalibView
            android:id="@+id/calib_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/calib_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="#99000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/calib_grabbing"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calib_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/calib_help"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/calib_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="@string/calib_info_idle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/calib_zoom"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_zoom_1"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:textSize="11sp"
                    android:text="@string/calib_zoom_1x" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_zoom_2"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:textSize="11sp"
                    android:text="@string/calib_zoom_2x" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_zoom_4"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:textSize="11sp"
                    android:text="@string/calib_zoom_4x" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_zoom_8"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="0dp"
                    android:textSize="11sp"
                    android:text="@string/calib_zoom_8x" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/calib_nudge"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_up"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="66dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/calib_up" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/calib_left"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="66dp"
                        android:layout_height="44dp"
                        android:text="@string/calib_left" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/calib_down"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="66dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/calib_down" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/calib_right"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="66dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/calib_right" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_grid"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/calib_grid" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_loupe"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/calib_loupe" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calib_centre"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/calib_centre" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_save"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/calib_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calib_cancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/calib_cancel" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
