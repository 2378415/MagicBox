<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!--
      Required even though this app never uses Camera2: for a USB device that
      reports video capture (any UVC capture card), UsbUserPermissionManager
      refuses the USB permission request outright - without showing the system
      dialog - unless the caller holds CAMERA. See
      UsbUserPermissionManager#requestPermission / #hasPermission.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 保活/常亮：屏幕常亮由 window flag 实现；CPU 唤醒需 WAKE_LOCK。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ 前台服务通知必须拿到该权限才会显示在通知栏（服务本身仍会运行）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 引导用户把本 App 加入电池优化白名单（OriginOS 等否则会冻结后台）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MagicBullet">

        <!--
          QNN HTP reaches the cDSP through FastRPC: libQnnHtpV81Stub.so dlopens
          libcdsprpc.so, which lives in /vendor/lib64. Since Android 12 a linker
          namespace only exposes a vendor library the app declares here, and without
          it QnnDevice_create fails with QNN_DEVICE_ERROR_INVALID_CONFIG.
        -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name=".ui.calib.AimCalibActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.MagicBullet" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：维持进程优先级 + 持有 PARTIAL_WAKE_LOCK，避免系统杀后台/冻结闭环。 -->
        <service
            android:name=".core.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep_alive_aim_loop" />
        </service>
    </application>

</manifest>
